{
  "name": "qurany-piroz-haram-explorer",
  "private": true,
  "version": "1.0.0",
  "description": "Masjid al-Haram 3D Explorer served at https://qurany-piroz.com/haram",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test",
    "release": "npm run check && npm run build",
    "serve:site": "node scripts/serve-site.mjs",
    "i18n:export": "UPDATE_CATALOG=1 vitest run tests/i18n-catalog.test.ts"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.1",
    "@types/three": "^0.186.0",
    "eslint": "^10.11.0",
    "globals": "^17.13.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
